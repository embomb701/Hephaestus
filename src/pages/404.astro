---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page doesn't exist.">
  <section class="section status">
    <div class="container status__inner">
      <p class="eyebrow">404</p>
      <h1>Nothing forged here.</h1>
      <p class="lede">That page doesn't exist, or it moved. Try one of these instead.</p>
      <div class="status__actions">
        <a class="btn btn--primary" href="/">Home</a>
        <a class="btn btn--ghost" href="/packages">Packages</a>
        <a class="btn btn--ghost" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .status {
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .status__inner {
    max-width: 720px;
  }
  .status__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
</style>
