# Copy to .env for local `netlify dev`. In production, set these in
# Netlify → Site configuration → Environment variables. Never commit .env.

# Stripe secret key (sk_test_... locally, sk_live_... in production)
STRIPE_SECRET_KEY=sk_test_replace_me

# Public URL of the site, no trailing slash. Used for Stripe success/cancel redirects.
# Netlify sets URL automatically; this is only needed for local dev.
SITE_URL=http://localhost:8888   # production: https://vf-customs.com
