---
// Posts to the Stripe checkout function. Plain HTML form so it works without JS.
import { formatUsd, type Package } from '../data/packages';

interface Props {
  pkg: Package;
  block?: boolean;
  ghost?: boolean;
}
const { pkg, block = false, ghost = false } = Astro.props;
---

<form method="post" action="/api/reserve" class="reserve">
  <input type="hidden" name="package" value={pkg.id} />
  <label class="hp" aria-hidden="true">
    Company site <input type="text" name="company_site" tabindex="-1" autocomplete="off" />
  </label>
  <button
    type="submit"
    class:list={['btn', ghost ? 'btn--ghost' : 'btn--primary', { 'btn--block': block }]}
  >
    Reserve a slot — {formatUsd(pkg.deposit)} deposit
  </button>
</form>

<style>
  .reserve {
    margin: 0;
  }
</style>
