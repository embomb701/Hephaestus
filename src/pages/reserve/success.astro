---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---

<Base title="Payment received" description="Your payment went through. Here's what happens next.">
  <section class="section status">
    <div class="container status__inner">
      <p class="eyebrow">Payment received</p>

      <div data-paid="reserve" class="status__variant">
        <h1>Your build slot is reserved.</h1>
        <p class="lede">Stripe has emailed you a receipt. This amount comes straight off your final one-time price.</p>
        <h3>What happens next</h3>
        <ol class="muted status__steps">
          <li>We email you within one business day to schedule a scoping call.</li>
          <li>On that call we map out exactly what your system needs to do.</li>
          <li>You get a written scope with a fixed price and timeline. Work starts with the kickoff payment once you approve it.</li>
        </ol>
      </div>

      <div data-paid="base" class="status__variant" hidden>
        <h1>Your base model is on the anvil.</h1>
        <p class="lede">Stripe has emailed you a receipt. We will have it set up and branded for you within days.</p>
        <h3>What happens next</h3>
        <ol class="muted status__steps">
          <li>We email you within one business day for your logo, colours and business details.</li>
          <li>If you chose Vulcan Hosted, we send you the link to start your monthly plan; otherwise we set it up on your device or your Google account.</li>
          <li>A short walkthrough call and a written guide, then it is yours.</li>
        </ol>
      </div>

      <div data-paid="hosted-small" data-paid-alt="hosted-shop hosted-fleet" class="status__variant" hidden>
        <h1>You're on Vulcan Hosted.</h1>
        <p class="lede">Stripe has emailed your receipt and will bill monthly. Cancel any time from the link on it.</p>
        <h3>What happens next</h3>
        <ol class="muted status__steps">
          <li>We email you within one business day with your system's address and logins.</li>
          <li>Your data, photos and backups now live on our servers; updates and support are included.</li>
          <li>Outgrow your tier? Tell us and we move you up with no downtime.</li>
        </ol>
      </div>

      <div data-paid="care-plan" class="status__variant" hidden>
        <h1>Care plan active.</h1>
        <p class="lede">Stripe has emailed your receipt and will renew yearly. Cancel any time from the link on it.</p>
        <h3>What happens next</h3>
        <ol class="muted status__steps">
          <li>We email you within one business day to confirm which system is covered.</li>
          <li>Updates and fixes come to you as they are ready; support is a call or email away.</li>
        </ol>
      </div>

      <div data-paid="kickoff" class="status__variant" hidden>
        <h1>The forge is lit.</h1>
        <p class="lede">Stripe has emailed you a receipt. Your build is now in progress.</p>
        <h3>What happens next</h3>
        <ol class="muted status__steps">
          <li>We confirm your start date by email within one business day.</li>
          <li>You get check-ins as the build comes together, so nothing surprises you.</li>
          <li>At handover we train your team, and the balance is invoiced through Stripe exactly as scoped.</li>
        </ol>
      </div>

      <p class="muted">
        Questions in the meantime? Call <a href={site.phoneHref}>{site.phone}</a> or email{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <div class="status__actions">
        <a class="btn btn--ghost" href="/">Back home</a>
      </div>
    </div>
  </section>

  <script>
    // Show the copy that matches which payment was just made (?paid=reserve|kickoff).
    const paid = new URLSearchParams(location.search).get('paid') ?? '';
    const variants = [...document.querySelectorAll<HTMLElement>('.status__variant')];
    const target = variants.find(
      (el) => el.dataset.paid === paid || (el.dataset.paidAlt ?? '').split(' ').includes(paid),
    );
    if (paid && target) {
      variants.forEach((el) => (el.hidden = el !== target));
    }
  </script>
</Base>

<style>
  .status {
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .status__inner {
    max-width: 720px;
  }
  .status__steps {
    padding-left: 20px;
    display: grid;
    gap: 6px;
    margin-bottom: 20px;
  }
  .status__actions {
    margin-top: 20px;
  }
</style>
