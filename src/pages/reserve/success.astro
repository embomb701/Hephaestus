---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---

<Base title="Slot reserved" description="Your build slot is reserved. Here's what happens next.">
  <section class="section status">
    <div class="container status__inner">
      <p class="eyebrow">Deposit received</p>
      <h1>Your build slot is reserved.</h1>
      <p class="lede">
        Stripe has emailed you a receipt. Your deposit comes straight off your final one-time price.
      </p>
      <h3>What happens next</h3>
      <ol class="muted status__steps">
        <li>We email you within one business day to schedule a scoping call.</li>
        <li>On that call we map out exactly what your system needs to do.</li>
        <li>You get a written scope with a fixed price and a timeline. Work starts when you approve it.</li>
      </ol>
      <p class="muted">
        Questions in the meantime? Call <a href={site.phoneHref}>{site.phone}</a> or email
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <div class="status__actions">
        <a class="btn btn--ghost" href="/">Back home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .status {
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .status__inner {
    max-width: 720px;
  }
  .status__steps {
    padding-left: 20px;
    display: grid;
    gap: 6px;
    margin-bottom: 20px;
  }
  .status__actions {
    margin-top: 20px;
  }
</style>
