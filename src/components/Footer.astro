---
import Logo from './Logo.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <a href="/" class="footer__brand"><Logo /></a>
        <p class="muted footer__tag">{site.tagline}</p>
        <p class="faint footer__note">
          Named for Vulcan, the Roman god of the forge, who built the tools the other gods relied on.
        </p>
      </div>

      <div>
        <h3 class="footer__h">Site</h3>
        <ul class="footer__list">
          <li><a href="/packages">Packages</a></li>
          <li><a href="/demos">Demos</a></li>
          <li><a href="/#how">How it works</a></li>
          <li><a href="/pay">Make a payment</a></li>
          <li><a href="/#faq">Questions</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer__h">Talk to us</h3>
        <ul class="footer__list">
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li class="muted">{site.serviceArea}</li>
        </ul>
      </div>
    </div>

    <hr class="divider" />
    <div class="footer__bottom">
      <span class="faint">&copy; {year} {site.name}. One payment. No subscriptions. You own it.</span>
      <span class="faint">Payments secured by Stripe.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    padding-block: 56px 28px;
    margin-top: auto;
  }
  .footer__grid {
    display: grid;
    gap: 36px;
    grid-template-columns: 1fr;
    padding-bottom: 36px;
  }
  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
  .footer__brand {
    text-decoration: none;
    display: inline-block;
    margin-bottom: 12px;
  }
  .footer__tag {
    margin: 0 0 8px;
  }
  .footer__note {
    font-size: 0.9rem;
    max-width: 38ch;
    margin: 0;
  }
  .footer__h {
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .footer__list a {
    color: var(--text);
    text-decoration: none;
  }
  .footer__list a:hover {
    color: var(--gold);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 20px;
    font-size: 0.88rem;
  }
</style>
